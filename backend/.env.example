# --- CONEXIÓN A BASE DE DATOS ---
# En Docker Compose usar el nombre del servicio: mongodb://mongo_db:27017/n8n_consultoria_db
# En local usar: mongodb://localhost:27017/n8n_consultoria_db
MONGO_URI=mongodb://mongo_db:27017/n8n_consultoria_db

# --- SEGURIDAD ---
# Cadena larga y aleatoria para encriptar sesiones. Cámbiala en producción.
SECRET_KEY=aqui_va_tu_clave_secreta_larga_y_aleatoria

# --- FRONTEND ---
# URL del frontend para los redirects de Stripe (sin barra final)
FRONTEND_URL=http://localhost:5173

# --- STRIPE ---
# Clave secreta de tu cuenta Stripe (empieza por sk_test_ en desarrollo)
STRIPE_SECRET_KEY=sk_test_aqui_va_tu_clave_secreta_de_stripe
# Secreto del webhook de Stripe (obtenido con: stripe listen --forward-to ...)
STRIPE_WEBHOOK_SECRET=whsec_aqui_va_tu_secreto_de_webhook

# --- SERVIDOR ---
# Puerto donde correrá Flask
PORT=5000
# True para desarrollo (ver errores), False para producción
DEBUG=True
